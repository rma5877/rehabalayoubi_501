log_info("Saving regression summaries to outputs/tables/")
log_info("Saving session information")
log_info("Snapshotting dependencies to renv.lock")
renv::snapshot()
log_info("Analysis pipeline completed successfully")
# ---- Packages ----
suppressPackageStartupMessages({
library(readr)
library(dplyr)
library(ggplot2)
library(broom)
})
# ---- Simple logging helpers ----
log_path <- "analysis log.txt"
log_info <- function(msg) {
line <- paste0("[", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), "] ", msg)
cat(line, "\n")
cat(line, "\n", file = log_path, append = TRUE)
}
# ---- Start log ----
log_info("=== START RUN ===")
log_info(paste("Working directory:", normalizePath(getwd(), winslash = "/")))
# ---- Load data ----
data_path <- "data/raw/education_income.csv"
if (!file.exists(data_path)) stop("Missing file: ", data_path)
education_income_raw <- read_csv(data_path, show_col_types = FALSE)
log_info(paste("Rows loaded:", nrow(education_income_raw)))
log_info(paste("Columns loaded:", ncol(education_income_raw)))
# ---- Inspect columns (for robust formula selection) ----
# We'll auto-detect likely column names to reduce breakage.
names_lower <- tolower(names(education_income_raw))
find_col <- function(candidates) {
idx <- which(names_lower %in% candidates)
if (length(idx) == 0) return(NA_character_)
names(education_income_raw)[idx[1]]
}
income_col <- find_col(c("income", "earnings", "wage", "salary"))
educ_col   <- find_col(c("education", "educ", "education_level", "edu"))
age_col    <- find_col(c("age"))
gender_col <- find_col(c("gender", "sex"))
hours_col  <- find_col(c("hours", "hours_worked", "hrs", "weekly_hours"))
race_col   <- find_col(c("race", "ethnicity"))
if (is.na(income_col)) stop("Couldn't find an income column. Columns are: ", paste(names(education_income_raw), collapse=", "))
# ---- Minimal cleaning: keep rows with income; coerce income numeric if needed ----
education_income <- education_income_raw %>%
mutate(
income_numeric = suppressWarnings(as.numeric(.data[[income_col]]))
) %>%
filter(!is.na(income_numeric))
log_info(paste("Rows after filtering missing income:", nrow(education_income)))
rhs1 <- c()
if (!is.na(educ_col)) rhs1 <- c(rhs1, educ_col)
if (length(rhs1) == 0) rhs1 <- c(rhs1, "1")
rhs2 <- rhs1
if (!is.na(age_col)) rhs2 <- c(rhs2, age_col)
rhs3 <- rhs2
for (v in c(gender_col, hours_col, race_col)) {
if (!is.na(v)) rhs3 <- c(rhs3, v)
}
f1 <- as.formula(paste("income_numeric ~", paste(rhs1, collapse = " + ")))
f2 <- as.formula(paste("income_numeric ~", paste(rhs2, collapse = " + ")))
f3 <- as.formula(paste("income_numeric ~", paste(rhs3, collapse = " + ")))
log_info(paste("Model 1 formula:", deparse(f1)))
log_info(paste("Model 2 formula:", deparse(f2)))
log_info(paste("Model 3 formula:", deparse(f3)))
# ---- Fit models ----
m1 <- lm(f1, data = education_income)
m2 <- lm(f2, data = education_income)
m3 <- lm(f3, data = education_income)
# ---- Save regression table (tidy) ----
reg_table <- bind_rows(
tidy(m1) %>% mutate(model = "Model 1"),
tidy(m2) %>% mutate(model = "Model 2"),
tidy(m3) %>% mutate(model = "Model 3")
) %>%
select(model, term, estimate, std.error, statistic, p.value)
table_path <- "outputs/tables/regressions_income_dv.csv"
write_csv(reg_table, table_path)
log_info(paste("Wrote table:", table_path))
# ---- Also save a simple model summary text file ----
summary_path <- "outputs/tables/model_summaries.txt"
sink(summary_path)
cat("Model 1\n"); print(summary(m1))
cat("\n\nModel 2\n"); print(summary(m2))
cat("\n\nModel 3\n"); print(summary(m3))
sink()
log_info(paste("Wrote summaries:", summary_path))
# ---- Plot (income vs education if possible; otherwise histogram of income) ----
fig_path <- "outputs/figures/income_plot.png"
if (!is.na(educ_col)) {
p <- ggplot(education_income, aes(x = .data[[educ_col]], y = income_numeric)) +
geom_point(alpha = 0.4) +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = "Income vs Education",
x = educ_col,
y = "Income"
) +
theme_minimal()
} else {
p <- ggplot(education_income, aes(x = income_numeric)) +
geom_histogram(bins = 30) +
labs(
title = "Income Distribution",
x = "Income",
y = "Count"
) +
theme_minimal()
}
ggsave(fig_path, plot = p, width = 9, height = 6, dpi = 300)
log_info(paste("Wrote figure:", fig_path))
# ---- Save sessionInfo to file ----
session_path <- "outputs/session info.txt"
capture.output(sessionInfo(), file = session_path)
log_info(paste("Wrote sessionInfo:", session_path))
log_info("=== END RUN ===")
