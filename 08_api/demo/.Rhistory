#    - Try mapping predicted differences (vote_pred) instead of observed vote_pct.
#
# 5) Extension:
#    - Build a new visualization for "close states" (vote_diff near 0).
###############################################################################
# 3) State model edits:
#    - Add economic predictors (unemploy_change, gdp_change, cpi_change).
#    - Compare model fit when you include vs exclude demographics.
#
# 4) Mapping edits:
#    - Try mapping predicted differences (vote_pred) instead of observed vote_pct.
#
# 5) Extension:
#    - Build a new visualization for "close states" (vote_diff near 0).
###############################################################################
# 3) State model edits:
#    - Add economic predictors (unemploy_change, gdp_change, cpi_change).
#    - Compare model fit when you include vs exclude demographics.
#
# 4) Mapping edits:
#    - Try mapping predicted differences (vote_pred) instead of observed vote_pct.
#
# 5) Extension:
#    - Build a new visualization for "close states" (vote_diff near 0).
###############################################################################
# -----------------------------------------------------------------------------
# Relative paths
# -----------------------------------------------------------------------------
vote_file <- file.path("data", "1976-2020-president.csv")
poll_file <- file.path("data", "poll_census_data.rds")
output_dir <- "output"
dir.create(output_dir, showWarnings = FALSE)
# -----------------------------------------------------------------------------
# Part 1: Read and clean presidential election vote data
# -----------------------------------------------------------------------------
vote_data <- read.csv(vote_file)
vote_data <- vote_data %>%
filter(party_detailed %in% c("DEMOCRAT", "REPUBLICAN"))
vote_data <- vote_data %>%
plyr::ddply(
.(year, candidate, party_detailed),
summarize,
candidatevotes = sum(candidatevotes, na.rm = TRUE),
totalvotes = sum(totalvotes, na.rm = TRUE)
)
vote_data <- vote_data %>%
filter(candidate != "OTHER", candidate != "")
vote_data <- vote_data %>%
mutate(vote_pct = candidatevotes / totalvotes)
cat("\n====================\n")
cat("Cleaned national vote data preview\n")
cat("====================\n")
print(head(vote_data, 10))
fred_key <- Sys.getenv("FRED_API_KEY")
fredr_set_key(fred_key)
cat("\n====================\n")
cat("FRED API key loaded from environment variable\n")
cat("====================\n")
cat("Key length:", nchar(fred_key), "\n")
# -----------------------------------------------------------------------------
# Part 3: Download FRED data for election years
# -----------------------------------------------------------------------------
election_years <- sort(unique(vote_data$year))
fred_start <- as.Date(paste0(min(election_years), "-01-01"))
fred_end   <- as.Date(paste0(max(election_years), "-06-30"))
# Baseline indicators
unemployment_raw <- fredr(
series_id = "UNRATE",
observation_start = fred_start,
observation_end = fred_end,
frequency = "q"
)
gdp_raw <- fredr(
series_id = "GDP",
observation_start = fred_start,
observation_end = fred_end,
frequency = "q"
)
cpi_raw <- fredr(
series_id = "CPIAUCSL",
observation_start = fred_start,
observation_end = fred_end,
frequency = "q"
)
umcsent_raw <- fredr(
series_id = "UMCSENT",
observation_start = fred_start,
observation_end = fred_end,
frequency = "m"
)
dspic96_raw <- fredr(
series_id = "DSPIC96",
observation_start = fred_start,
observation_end = fred_end,
frequency = "q"
)
fedfunds_raw <- fredr(
series_id = "FEDFUNDS",
observation_start = fred_start,
observation_end = fred_end,
frequency = "m"
)
cat("\n====================\n")
cat("FRED API call worked: preview of unemployment data\n")
cat("====================\n")
print(head(unemployment_raw, 8))
# -----------------------------------------------------------------------------
# Part 4: Clean FRED series and keep Q1/Q2 of election years
# -----------------------------------------------------------------------------
unemployment_data <- unemployment_raw %>%
filter(year(date) %in% election_years, quarter(date) <= 2) %>%
select(date, value) %>%
rename(unemployment_rate = value)
gdp_data <- gdp_raw %>%
filter(year(date) %in% election_years, quarter(date) <= 2) %>%
select(date, value) %>%
rename(gdp = value)
cpi_data <- cpi_raw %>%
filter(year(date) %in% election_years, quarter(date) <= 2) %>%
select(date, value) %>%
rename(cpi = value)
# Quarterly inflation example
inflation_data <- cpi_data %>%
arrange(date) %>%
mutate(
inflation_rate = (cpi / lag(cpi, 2) - 1) * 100
)
# Monthly series -> quarter averages
umcsent_data <- umcsent_raw %>%
mutate(year = year(date), quarter = quarter(date)) %>%
filter(year %in% election_years, quarter <= 2) %>%
group_by(year, quarter) %>%
summarize(consumer_sentiment = mean(value, na.rm = TRUE), .groups = "drop")
fedfunds_data <- fedfunds_raw %>%
mutate(year = year(date), quarter = quarter(date)) %>%
filter(year %in% election_years, quarter <= 2) %>%
group_by(year, quarter) %>%
summarize(fedfunds = mean(value, na.rm = TRUE), .groups = "drop")
dspic96_data <- dspic96_raw %>%
filter(year(date) %in% election_years, quarter(date) <= 2) %>%
mutate(
year = year(date),
quarter = quarter(date)
) %>%
select(year, quarter, value) %>%
rename(real_income = value)
# Turn quarterly baseline series into year-quarter format
unemployment_q <- unemployment_data %>%
mutate(year = year(date), quarter = quarter(date)) %>%
select(year, quarter, unemployment_rate)
gdp_q <- gdp_data %>%
mutate(year = year(date), quarter = quarter(date)) %>%
select(year, quarter, gdp)
cpi_q <- cpi_data %>%
mutate(year = year(date), quarter = quarter(date)) %>%
select(year, quarter, cpi)
inflation_q <- inflation_data %>%
mutate(year = year(date), quarter = quarter(date)) %>%
select(year, quarter, inflation_rate)
# -----------------------------------------------------------------------------
# Part 5: Combine economic data and reshape wide
# -----------------------------------------------------------------------------
combined_data_long <- unemployment_q %>%
full_join(gdp_q, by = c("year", "quarter")) %>%
full_join(cpi_q, by = c("year", "quarter")) %>%
full_join(inflation_q, by = c("year", "quarter")) %>%
full_join(umcsent_data, by = c("year", "quarter")) %>%
full_join(fedfunds_data, by = c("year", "quarter")) %>%
full_join(dspic96_data, by = c("year", "quarter")) %>%
arrange(year, quarter)
combined_data <- combined_data_long %>%
pivot_wider(
id_cols = year,
names_from = quarter,
values_from = c(
unemployment_rate, gdp, cpi, inflation_rate,
consumer_sentiment, fedfunds, real_income
),
names_sep = "_Q"
)
cat("\n====================\n")
cat("Combined economic data preview\n")
cat("====================\n")
print(head(combined_data, 10))
# -----------------------------------------------------------------------------
# Part 6: National baseline model (replicate baseline pipeline)
# -----------------------------------------------------------------------------
forecast_data <- vote_data %>%
left_join(combined_data, by = "year")
forecast_data <- forecast_data %>%
mutate(
incumbent = as.integer(
(candidate == "FORD, GERALD"       & year == 1976) |
(candidate == "CARTER, JIMMY"      & year == 1980) |
(candidate == "REAGAN, RONALD"     & year == 1984) |
(candidate == "BUSH, GEORGE H.W."  & year == 1992) |
(candidate == "CLINTON, BILL"      & year == 1996) |
(candidate == "BUSH, GEORGE W."    & year == 2004) |
(candidate == "OBAMA, BARACK H."   & year == 2012) |
(candidate == "TRUMP, DONALD J."   & year == 2020)
),
gdp_change = gdp_Q2 - gdp_Q1,
cpi_change = cpi_Q2 - cpi_Q1,
unemploy_change = unemployment_rate_Q2 - unemployment_rate_Q1
)
forecast_data_training <- forecast_data %>%
filter(year < 2020)
forecast_data_testing <- forecast_data %>%
filter(year == 2020)
train_ols <- lm(
vote_pct ~ incumbent * unemploy_change + party_detailed + poly(year, 2, raw = TRUE),
data = forecast_data_training
)
forecast_data_training$pred_vote <- predict(train_ols, newdata = forecast_data_training)
forecast_data_testing$pred_vote  <- predict(train_ols, newdata = forecast_data_testing)
cat("\n====================\n")
cat("Baseline national OLS model summary\n")
cat("====================\n")
print(summary(train_ols))
cat("\n====================\n")
cat("Held-out 2020 national predictions\n")
cat("====================\n")
print(
forecast_data_testing %>%
select(year, candidate, party_detailed, vote_pct, pred_vote)
)
# Save national baseline predictions
write_csv(
forecast_data_testing %>%
select(year, candidate, party_detailed, vote_pct, pred_vote),
file.path(output_dir, "baseline_national_predictions_2020.csv")
)
# -----------------------------------------------------------------------------
# Part 7: State-level data for out-of-sample comparison
# -----------------------------------------------------------------------------
poll_census_data <- readRDS(poll_file)
econ_by_year <- forecast_data %>%
distinct(
year,
unemployment_rate_Q1, unemployment_rate_Q2,
gdp_Q1, gdp_Q2,
cpi_Q1, cpi_Q2,
inflation_rate_Q1, inflation_rate_Q2,
consumer_sentiment_Q1, consumer_sentiment_Q2,
fedfunds_Q1, fedfunds_Q2,
real_income_Q1, real_income_Q2,
gdp_change, cpi_change, unemploy_change
) %>%
mutate(
inflation_change = inflation_rate_Q2 - inflation_rate_Q1,
sentiment_change = consumer_sentiment_Q2 - consumer_sentiment_Q1,
fedfunds_change = fedfunds_Q2 - fedfunds_Q1,
income_change = real_income_Q2 - real_income_Q1,
unemployment_avg = (unemployment_rate_Q1 + unemployment_rate_Q2) / 2,
gdp_avg = (gdp_Q1 + gdp_Q2) / 2,
cpi_avg = (cpi_Q1 + cpi_Q2) / 2,
sentiment_avg = (consumer_sentiment_Q1 + consumer_sentiment_Q2) / 2,
fedfunds_avg = (fedfunds_Q1 + fedfunds_Q2) / 2,
income_avg = (real_income_Q1 + real_income_Q2) / 2
)
state_data <- poll_census_data %>%
left_join(econ_by_year, by = "year")
# -----------------------------------------------------------------------------
# Part 8: Explicit out-of-sample design
# Train: years < 2020
# Test:  year == 2020
# -----------------------------------------------------------------------------
state_train <- state_data %>%
filter(year < 2020)
state_test <- state_data %>%
filter(year == 2020)
# -----------------------------------------------------------------------------
# Part 9: Baseline state model
# -----------------------------------------------------------------------------
baseline_state_model <- lm(
vote_pct ~ poll_avg + year + party_simplified + white + black + asian + hispanic,
data = state_train
)
state_test$pred_baseline <- predict(baseline_state_model, newdata = state_test)
cat("\n====================\n")
cat("Baseline state model summary\n")
cat("====================\n")
print(summary(baseline_state_model))
# Keep only variables needed for improved model
state_train_improved <- state_train %>%
select(
vote_pct, poll_avg, year, party_simplified, white, black, asian, hispanic,
unemployment_avg, gdp_avg, cpi_avg, sentiment_avg, fedfunds_avg, income_avg,
unemploy_change, gdp_change, cpi_change, sentiment_change, fedfunds_change, income_change
)
state_test_improved <- state_test %>%
select(
vote_pct, poll_avg, year, party_simplified, white, black, asian, hispanic,
unemployment_avg, gdp_avg, cpi_avg, sentiment_avg, fedfunds_avg, income_avg,
unemploy_change, gdp_change, cpi_change, sentiment_change, fedfunds_change, income_change
)
# Model matrix for elastic net
x_train <- model.matrix(
vote_pct ~ poll_avg + poly(year, 2, raw = TRUE) + party_simplified +
white + black + asian + hispanic +
unemployment_avg + gdp_avg + cpi_avg + sentiment_avg + fedfunds_avg + income_avg +
unemploy_change + gdp_change + cpi_change + sentiment_change + fedfunds_change + income_change +
poll_avg:party_simplified,
data = state_train_improved
)[, -1]
y_train <- state_train_improved$vote_pct
x_test <- model.matrix(
vote_pct ~ poll_avg + poly(year, 2, raw = TRUE) + party_simplified +
white + black + asian + hispanic +
unemployment_avg + gdp_avg + cpi_avg + sentiment_avg + fedfunds_avg + income_avg +
unemploy_change + gdp_change + cpi_change + sentiment_change + fedfunds_change + income_change +
poll_avg:party_simplified,
data = state_test_improved
)[, -1]
# Elastic net cross-validation
set.seed(123)
cv_enet <- cv.glmnet(
x = x_train,
y = y_train,
alpha = 0.5,
nfolds = 10,
standardize = TRUE
)
state_test$pred_improved <- as.numeric(
predict(cv_enet, newx = x_test, s = "lambda.min")
)
cat("\n====================\n")
cat("Elastic net chosen lambda\n")
cat("====================\n")
print(cv_enet$lambda.min)
# -----------------------------------------------------------------------------
# Part 11: Evaluate out-of-sample performance
# -----------------------------------------------------------------------------
mae <- function(actual, predicted) {
mean(abs(actual - predicted), na.rm = TRUE)
}
rmse <- function(actual, predicted) {
sqrt(mean((actual - predicted)^2, na.rm = TRUE))
}
baseline_mae <- mae(state_test$vote_pct, state_test$pred_baseline)
baseline_rmse <- rmse(state_test$vote_pct, state_test$pred_baseline)
improved_mae <- mae(state_test$vote_pct, state_test$pred_improved)
improved_rmse <- rmse(state_test$vote_pct, state_test$pred_improved)
performance_table <- tibble(
model = c("Baseline OLS", "Improved Elastic Net"),
test_year = 2020,
MAE = c(baseline_mae, improved_mae),
RMSE = c(baseline_rmse, improved_rmse)
)
cat("\n====================\n")
cat("Out-of-sample performance comparison\n")
cat("====================\n")
print(performance_table)
write_csv(
performance_table,
file.path(output_dir, "baseline_vs_improved_performance.csv")
)
# -----------------------------------------------------------------------------
# Part 12: Save prediction-level results
# -----------------------------------------------------------------------------
prediction_results <- state_test %>%
select(year, state_po, candidate, party_simplified, vote_pct, pred_baseline, pred_improved) %>%
mutate(
abs_error_baseline = abs(vote_pct - pred_baseline),
abs_error_improved = abs(vote_pct - pred_improved)
)
cat("Out-of-sample performance comparison\n")
cat("====================\n")
print(performance_table)
write_csv(
performance_table,
file.path(output_dir, "baseline_vs_improved_performance.csv")
)
# -----------------------------------------------------------------------------
# Part 12: Save prediction-level results
# -----------------------------------------------------------------------------
prediction_results <- state_test %>%
select(year, state_po, candidate, party_simplified, vote_pct, pred_baseline, pred_improved) %>%
mutate(
abs_error_baseline = abs(vote_pct - pred_baseline),
abs_error_improved = abs(vote_pct - pred_improved)
)
sqrt(mean((actual - predicted)^2, na.rm = TRUE))
rmse <- function(actual, predicted) {
sqrt(mean((actual - predicted)^2, na.rm = TRUE))
}
baseline_mae <- mae(state_test$vote_pct, state_test$pred_baseline)
baseline_rmse <- rmse(state_test$vote_pct, state_test$pred_baseline)
improved_mae <- mae(state_test$vote_pct, state_test$pred_improved)
improved_rmse <- rmse(state_test$vote_pct, state_test$pred_improved)
performance_table <- tibble(
model = c("Baseline OLS", "Improved Elastic Net"),
test_year = 2020,
MAE = c(baseline_mae, improved_mae),
RMSE = c(baseline_rmse, improved_rmse)
)
cat("\n====================\n")
cat("Out-of-sample performance comparison\n")
cat("====================\n")
print(performance_table)
write_csv(
performance_table,
file.path(output_dir, "baseline_vs_improved_performance.csv")
)
# -----------------------------------------------------------------------------
# Part 12: Save prediction-level results
# -----------------------------------------------------------------------------
prediction_results <- state_test %>%
select(year, state_po, candidate, party_simplified, vote_pct, pred_baseline, pred_improved) %>%
mutate(
abs_error_baseline = abs(vote_pct - pred_baseline),
abs_error_improved = abs(vote_pct - pred_improved)
)
write_csv(
prediction_results,
file.path(output_dir, "state_level_predictions_2020.csv")
)
# -----------------------------------------------------------------------------
# Part 13: Figure - predicted vs actual (baseline vs improved)
# -----------------------------------------------------------------------------
plot_data <- prediction_results %>%
pivot_longer(
cols = c(pred_baseline, pred_improved),
names_to = "model",
values_to = "predicted"
) %>%
mutate(
model = recode(
model,
pred_baseline = "Baseline OLS",
pred_improved = "Improved Elastic Net"
)
)
p1 <- ggplot(plot_data, aes(x = vote_pct, y = predicted)) +
geom_point(alpha = 0.7) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
facet_wrap(~ model) +
labs(
title = "Predicted vs Actual Vote Share (Held-Out 2020 Data)",
x = "Actual Vote Share",
y = "Predicted Vote Share"
) +
theme_bw()
ggsave(
filename = file.path(output_dir, "predicted_vs_actual_2020.png"),
plot = p1,
width = 10,
height = 5,
dpi = 300
)
elect_outcomes <- state_test %>%
select(year, state_po, party_simplified, candidate, vote_pct, pred_baseline, pred_improved)
elect_outcome_diff_2020 <- elect_outcomes %>%
filter(year == 2020) %>%
pivot_wider(
id_cols = c(state_po, year),
names_from = candidate,
values_from = vote_pct,
names_glue = "{tolower(gsub('[^A-Za-z]', '', candidate))}_vote_pct"
)
# Adjust these names if needed after checking colnames()
print(colnames(elect_outcome_diff_2020))
vote_diff_2020 <- elect_outcome_diff_2020 %>%
mutate(
vote_diff = bidenjosephrjr_vote_pct - trumpdonaldj_vote_pct
) %>%
distinct(state_po, vote_diff)
us_states <- map_data("state")
state_mapping <- data.frame(
region = tolower(c(state.name, "district of columbia")),
state_po = c(state.abb, "DC"),
stringsAsFactors = FALSE
)
us_states <- us_states %>%
left_join(state_mapping, by = "region")
map_df <- left_join(us_states, vote_diff_2020, by = "state_po", relationship = "many-to-many") %>%
filter(!is.na(vote_diff))
p2 <- ggplot(map_df, aes(long, lat, group = group, fill = vote_diff)) +
geom_polygon(color = "white", linewidth = 0.2) +
coord_map("albers", lat0 = 39, lat1 = 45) +
scale_fill_gradient2(
low = "red",
mid = "white",
high = "blue",
midpoint = 0,
name = "Dem - Rep\nVote Share"
) +
theme_bw() +
labs(
title = "2020 State Vote Share Difference",
x = "Longitude",
y = "Latitude"
)
ggsave(
filename = file.path(output_dir, "state_vote_diff_map_2020.png"),
plot = p2,
width = 10,
height = 6,
dpi = 300
)
print(p2)
# -----------------------------------------------------------------------------
# Part 15: Final console output
# -----------------------------------------------------------------------------
cat("\n====================\n")
cat("Assignment outputs saved\n")
cat("====================\n")
cat("1) ", file.path(output_dir, "baseline_national_predictions_2020.csv"), "\n", sep = "")
cat("2) ", file.path(output_dir, "baseline_vs_improved_performance.csv"), "\n", sep = "")
cat("3) ", file.path(output_dir, "state_level_predictions_2020.csv"), "\n", sep = "")
cat("4) ", file.path(output_dir, "predicted_vs_actual_2020.png"), "\n", sep = "")
cat("5) ", file.path(output_dir, "state_vote_diff_map_2020.png"), "\n", sep = "")
